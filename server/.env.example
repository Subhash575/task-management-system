# Copy to server/.env for local (non-Docker) development:  cp .env.example .env
# Never commit the real .env file.

# REQUIRED: development, test or production (there is no default, so a forgotten value fails loudly).
NODE_ENV=development
PORT=5000

# How many reverse proxies sit in front of the API (used to find the real client IP for rate limiting).
# 1 = one proxy (e.g. Render directly). 2 = Vercel /api rewrite in front of Render. Default: 1
TRUST_PROXY_HOPS=1

# Local MongoDB (e.g. started with `docker compose up mongo`)
MONGODB_URI=mongodb://localhost:27017/task-management

# Frontend origin allowed by CORS (must match exactly, no trailing slash)
CLIENT_URL=http://localhost:5173

# Optional. Comma-separated DNS servers for Node to use. Set this only if a
# mongodb+srv:// (Atlas) URI fails with "querySrv ECONNREFUSED".
# DNS_SERVERS=8.8.8.8,1.1.1.1

# --- Authentication ---
# REQUIRED, at least 32 characters. Intentionally left empty: the server will not start
# until you set your own. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Use a different secret in every environment, and keep it out of Git.
JWT_SECRET=

# How long a login lasts: a number followed by s, m, h or d. Controls both the token
# and the cookie lifetime. Default: 7d
JWT_EXPIRES_IN=7d

# Name of the HTTP-only session cookie. Default: taskflow_session
COOKIE_NAME=taskflow_session

# --- File attachments ---
# Where uploaded files are kept:
#   local  - files in UPLOAD_DIR on this machine. Development only (most hosts, including Render, erase the
#            disk on every deploy). This is the default.
#   s3     - any S3-compatible bucket (AWS S3, Cloudflare R2, MinIO). REQUIRED in production.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads

# Needed only when STORAGE_DRIVER=s3. Use a PRIVATE bucket: files are served through the API, never by public URL.
# Create a key that can only read, write and delete objects in this one bucket, and keep it out of Git.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only for non-AWS providers, e.g. https://<account-id>.r2.cloudflarestorage.com (R2) or http://localhost:9000 (MinIO).
S3_ENDPOINT=
# "true" for MinIO and some other providers that use path-style URLs. Default: false
S3_FORCE_PATH_STYLE=false
