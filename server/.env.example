# Copy to server/.env for local (non-Docker) development:  cp .env.example .env
# Never commit the real .env file.

NODE_ENV=development
PORT=5000

# Local MongoDB (e.g. started with `docker compose up mongo`)
MONGODB_URI=mongodb://localhost:27017/task-management

# Frontend origin allowed by CORS (must match exactly, no trailing slash)
CLIENT_URL=http://localhost:5173

# Optional. Comma-separated DNS servers for Node to use. Set this only if a
# mongodb+srv:// (Atlas) URI fails with "querySrv ECONNREFUSED".
# DNS_SERVERS=8.8.8.8,1.1.1.1

# --- Authentication ---
# REQUIRED, at least 32 characters. Intentionally left empty: the server will not start
# until you set your own. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Use a different secret in every environment, and keep it out of Git.
JWT_SECRET=

# How long a login lasts: a number followed by s, m, h or d. Controls both the token
# and the cookie lifetime. Default: 7d
JWT_EXPIRES_IN=7d

# Name of the HTTP-only session cookie. Default: taskflow_session
COOKIE_NAME=taskflow_session
