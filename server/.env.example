# Copy to server/.env for local (non-Docker) development:  cp .env.example .env
# Never commit the real .env file.

NODE_ENV=development
PORT=5000

# Local MongoDB (e.g. started with `docker compose up mongo`)
MONGODB_URI=mongodb://localhost:27017/task-management

# Frontend origin allowed by CORS (must match exactly, no trailing slash)
CLIENT_URL=http://localhost:5173

# Optional. Comma-separated DNS servers for Node to use. Set this only if a
# mongodb+srv:// (Atlas) URI fails with "querySrv ECONNREFUSED".
# DNS_SERVERS=8.8.8.8,1.1.1.1
