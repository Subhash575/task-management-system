# Optional. Copy to client/.env.local to override. Never put secrets here:
# every VITE_* variable is embedded in the public JavaScript bundle.

# Base URL the browser uses for API calls. Defaults to "/api" (proxied by Vite in dev).
VITE_API_URL=/api

# Dev-server only (NOT exposed to the browser): where Vite forwards /api requests.
# Defaults to http://localhost:5000; Docker Compose sets it to http://server:5000.
API_PROXY_TARGET=http://localhost:5000
